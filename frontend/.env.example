# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pathai?schema=public"

# YouTube Data API v3 Configuration
YOUTUBE_API_KEY=""

# AI Provider Configuration (Google Gemini / OpenAI compatible)
AI_API_KEY=""
GEMINI_API_KEY=""
AI_MODEL="gemini-2.5-flash"
AI_BASE_URL="https://generativelanguage.googleapis.com"

# Authentication Secrets
JWT_SECRET="pathai-super-secure-jwt-secret-key-2026"
JWT_REFRESH_SECRET="pathai-super-secure-refresh-secret-key-2026"
AUTH_SECRET="pathai-auth-secret-key-2026"

# Code Execution Sandbox Configuration
CODE_EXECUTION_TIMEOUT_MS=5000
CODE_EXECUTION_MAX_BUFFER_BYTES=524288
PYTHON_PATH="python3"
